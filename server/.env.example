NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# LIVE MongoDB (local Docker / installed mongod)
MONGODB_URI=mongodb://127.0.0.1:27017/yatragenie
USE_IN_MEMORY_DB=false

# Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/yatragenie

CLIENT_URL=http://localhost:5173
CORS_EXTRA_ORIGINS=

JWT_SECRET=change-me-access-secret-min-32-chars-long
REFRESH_TOKEN_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=YatraGenie <noreply@yatragenie.local>

LOCATION_RETENTION_DAYS=14
MAX_AVATAR_BYTES=2097152
MAPS_PROVIDER=geometric
