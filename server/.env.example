NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Leave empty + USE_IN_MEMORY_DB=true for local/demo without Atlas
MONGODB_URI=
USE_IN_MEMORY_DB=true

CLIENT_URL=http://localhost:5173
CORS_EXTRA_ORIGINS=

JWT_SECRET=change-me-access-secret-min-32-chars-long
REFRESH_TOKEN_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=YatraGenie <noreply@yatragenie.local>

LOCATION_RETENTION_DAYS=14
MAX_AVATAR_BYTES=2097152

# Optional maps provider (leave empty to use geometric adapter)
MAPS_PROVIDER=geometric
